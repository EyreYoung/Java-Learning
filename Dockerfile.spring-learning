# syntax=docker/dockerfile:1.7

# 构建阶段
FROM maven:3-eclipse-temurin-17 AS build
WORKDIR /app

# 先复制父 pom 和其他模块的 pom（用于依赖解析）
COPY pom.xml ./pom.xml
COPY dubbo-api/pom.xml ./dubbo-api/pom.xml
COPY dubbo-provider/pom.xml ./dubbo-provider/pom.xml
COPY java-learning-base/pom.xml ./java-learning-base/pom.xml
COPY dubbo-consumer/pom.xml ./dubbo-consumer/pom.xml
COPY email-spring-starter/pom.xml ./email-spring-starter/pom.xml
COPY spring-learning/pom.xml ./spring-learning/pom.xml
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B dependency:go-offline -pl spring-learning -am || true

# 复制源码并构建
COPY java-learning-base/src ./java-learning-base/src
COPY spring-learning/src ./spring-learning/src
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B clean package -pl spring-learning -am -DskipTests

# 运行阶段
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/spring-learning/target/spring-learning-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-Xmx256m", "-jar", "app.jar"]
